#!/usr/bin/env bash
# Thin wrapper: resolves the vendored mklittlefs binary for the current
# host and execs it. Callers shouldn't care which platform-specific
# binary is on disk -- just run `tools/mklittlefs/mklittlefs ...`.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

uname_s="$(uname -s)"
uname_m="$(uname -m)"

case "${uname_s}-${uname_m}" in
  Darwin-arm64)   bin="mklittlefs-darwin-arm64" ;;
  Darwin-x86_64)  bin="mklittlefs-darwin-x86_64" ;;
  Linux-x86_64)   bin="mklittlefs-linux-x86_64" ;;
  Linux-aarch64)  bin="mklittlefs-linux-aarch64" ;;
  Linux-armv7l)   bin="mklittlefs-linux-armv7l" ;;
  *)
    echo "mklittlefs: unsupported host ${uname_s}-${uname_m}" >&2
    exit 1
    ;;
esac

path="${HERE}/${bin}"
if [[ ! -x "${path}" ]]; then
  echo "mklittlefs: ${bin} not vendored; run ${HERE}/fetch.sh" >&2
  exit 1
fi

exec "${path}" "$@"
