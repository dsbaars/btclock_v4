CONFIG_IDF_TARGET="esp32s3"

# Static fallback for the LwIP DHCP option-12 hostname. Routers display
# whatever string is announced here when esp_netif_set_hostname() hasn't
# (yet) overridden it. Default is "espressif" — bumping it to "btclock"
# means a misconfigured / pre-Connect read still surfaces a sane name.
# At runtime InitNetwork calls esp_netif_set_hostname with the user's
# `<hostnamePrefix>-<mac6>` value, so this static is only a safety net.
CONFIG_LWIP_LOCAL_HOSTNAME="btclock"

# Bump LWIP socket pool from the IDF default of 10. The firmware runs
# at minimum: httpd listener + 0–4 accepted conns, Nostr WSS (1–2),
# bitaxe HTTP poller (transient), noderunners HTTPS poller (transient),
# mDNS, plus sntp/dns. Steady-state of 4–6 with bursts to 8+ leaves
# zero margin against any FD leak; 16 gives breathing room while a
# real attribution effort runs (see diag socket-census log in
# main/app/event_loop.cpp). Each extra socket is ~ a few hundred
# bytes of internal RAM — cheap.
CONFIG_LWIP_MAX_SOCKETS=16

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Rev A and Rev B both ship ESP32-S3 with 2 MB quad PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Was 16384 (every alloc < 16 KiB pinned to internal DRAM "for handshake
# latency"). Dropped to 0 after a 10-min heap_trace on Rev A pinned a
# slow ~3 KiB / 15 min internal-heap drift to esp_crt_bundle.c:489
# (`esp_crt_ca_cb_callback` leaking 2–168 B X.509 fragments per HTTPS
# handshake — IDF v6.0.1 issue, see comment in init_mbedtls_psram.cpp).
# At 0 every default malloc tries PSRAM first; the leak still exists
# but bleeds into the 1.95 MiB PSRAM pool instead of the 75 KiB
# internal one — time-to-failure goes from ~5 h to weeks. Tiny per-
# alloc latency cost is invisible at the screens-renderer + 1-Hz poll
# cadence this firmware runs at.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Drop runtime logs to WARN — strips ESP_LOGI format-string rodata
# from the linked image. Serial console still prints WARN/ERROR.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Cap *compile-time* log level at WARN so ESP_LOGI/ESP_LOGD/ESP_LOGV
# bodies are eliminated entirely (default would otherwise track
# DEFAULT_LEVEL but still leave INFO compiled in).
CONFIG_LOG_MAXIMUM_LEVEL_WARN=y

# Size-trim mbedTLS: device only verifies server certs and signs
# Nostr events; it never writes PEM/X.509 CSRs, never runs the
# crypto self-test suite, and never parses PKCS#7 bundles (Secure
# Boot V2 isn't enabled). Error-string tables drop tens of KiB of
# diagnostic strings.
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_SELF_TEST=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
# NOTE: PK_WRITE_C must stay on — wpa_supplicant pulls in
# mbedtls_pk_write_{pubkey,key}_der via crypto_mbedtls-{rsa,ec}.c.
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
# Brainpool curves are not used by any public CA we connect to
# (LE / Cloudflare / GTS chains use SECP256R1/384R1). secp521r1 is
# similarly unused. Curve25519 is kept for completeness — disabling
# it currently saves <1 KiB and risks future TLS 1.3 hosts.
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n

# GDB stub costs ~6 KiB of flash and we have no in-field debugger.
# Panic handler still reboots; field crashes are captured via the
# coredump partition below and pulled off the device with
# `GET /api/coredump`.
CONFIG_ESP_GDBSTUB_ENABLED=n

# Capture panic backtraces to the `coredump` partition (carved into
# all three partitions_*.csv at offset = end_of_storage). Without this
# a Rev B in the field that panics loses the backtrace forever — the
# WARN-level serial console only catches it if a developer happens to
# be tailing USB at the moment of the crash. ELF format lets us decode
# with `espcoredump.py info_corefile`; CRC32 matches the partition's
# default checksum. 32 tasks is generous (BTClock runs ~12) and keeps
# the dump well under the 64 KiB partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32

# IPv6 unused: btclock only talks to IPv4 endpoints (ws.btclock.dev,
# relay.primal.net, mempool.space, pool APIs) and mDNS works over
# IPv4 link-local. Disabling drops ~8-12 KiB of lwIP code/data and a
# chunk of the IPv6 ND6 neighbor tables out of bss.
CONFIG_LWIP_IPV6=n

# Trim assertions to "silent": full assertion strings include
# __FILE__ + __LINE__ rodata for every assert() in the IDF tree;
# dropping to silent keeps the abort-on-fail behaviour but strips
# the diagnostic strings. Trades crash-localisation for ~10-20 KiB.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_HAL_ASSERTION_SILENT=y

# Interrupt-context backtrace adds rodata + IRAM helpers to the
# panic path; we read panics off serial / coredump suffices.
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=n

CONFIG_FREERTOS_HZ=1000

# The main task runs the render + SSE status-broadcast path in
# main.cpp's app_main loop. With the screen_manager renderer (font
# rasterisation, on-stack panel composition) and an active SSE client
# subscribed, the default 3584 B stack overflows during a rotation —
# deterministic crash observed on Rev B with 'A stack overflow in task
# main has been detected' and vApplicationStackOverflowHook in the
# backtrace. 8 KiB gives ~2x headroom over the observed peak.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# TLS root certs for ws.btclock.dev — use the bundled CA store rather
# than embedding a specific root, so the client keeps working if the
# upstream cert is rotated under an existing trusted CA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# IDF v6 split cross-signed chain handling behind a new Kconfig
# (mbedTLS 4.x no longer auto-walks alternate trust paths). Both
# ws.btclock.dev and relay.primal.net present chains that terminate
# at GTS Root R4 *cross-signed by GlobalSign Root CA* — without this
# knob, the bundle search keys on the topmost cert's issuer
# (GlobalSign Root CA) and fails to recognise GTS Root R4 already in
# the bundle as a trusted self-signed root, which surfaces as
# "No matching trusted root certificate found" + handshake failure.
# Costs ~700 B of heap at handshake; required for v6 parity with v5.x.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# TLS buffer tuning — Rev B has three concurrent TLS clients (price WSS
# to ws.btclock.dev, Nostr WSS to relay.primal.net, mining-pool HTTPS
# poller; the bitaxe poller is plain HTTP and pays no TLS cost). With
# default symmetric 16 KiB IN + 4 KiB OUT per session, ~60 KiB of
# internal heap is parked in mbedtls buffers even while idle — on 2 MB
# PSRAM Rev B that leaves steady-state free internal heap at ~32 KiB,
# too thin for handshake storms on reconnect. Three complementary knobs
# below cut that cost:
#
#  1. DYNAMIC_BUFFER frees the IN/OUT buffers between TLS records so an
#     idle connection holds ~0 bytes of buffer instead of ~20 KiB.
#  2. SSL_IN_CONTENT_LEN=4096 caps the worst-case transient allocation
#     at 16 KiB — Cloudflare-fronted endpoints (mempool.space) send a
#     ServerHello + Certificate chain that exceeds 4 KiB, which trips
#     MBEDTLS_ERR_SSL_FATAL_ALERT_MESSAGE during handshake when the
#     buffer is too small. Bumping to the TLS record max (16 KiB) with
#     DYNAMIC_BUFFER on means the cost is paid only while the
#     handshake/large-frame is in flight; idle connections shrink back.
#  3. SSL_OUT_CONTENT_LEN=2048 — we only send tiny subscribe frames +
#     GET request lines, never >1 KiB.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Free private key + DHM data after the handshake completes. We have no
# client cert (every TLS client uses esp_crt_bundle for server-cert
# verification only — see crt_bundle_attach call sites in pool_base.cpp,
# relay_client.cpp, ota_manager.cpp, mempool_kraken_source.cpp), and
# every connection builds a fresh esp_tls context (esp_tls_init() at
# tcp_transport/transport_ssl.c:72,112) so the freed config is never
# needed for a second handshake on the same SSL object. The companion
# CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y is already implied by the
# default since we depend on FREE_CONFIG_DATA — the cert bundle is
# re-attached on each new connection via cfg->crt_bundle_attach.
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# Route mbedtls dynamic allocations through the default IDF malloc.
# Combined with SPIRAM_MALLOC_ALWAYSINTERNAL=0 above, every mbedtls
# alloc tries PSRAM first. We additionally install an explicit PSRAM
# calloc/free pair for mbedtls in init_mbedtls_psram.cpp — belt and
# suspenders, so even allocations that bypass the C runtime malloc
# wrapper still land in PSRAM.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Expose esp_http_client_config_t.transport so we can inject a custom
# proxy-aware transport at every HTTP/HTTPS init point. Default in IDF
# v6.0 is `n`; without this the schema field stays present but the
# client ignores it. See components/proxy_transport/.
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y

CONFIG_PARTITION_TABLE_CUSTOM=y
# Flash size + partition CSV live in the per-variant sdkconfig.defaults.<rev>.
CONFIG_HTTPD_WS_SUPPORT=y
