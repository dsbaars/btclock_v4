build/
build-*/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# MkDocs Material doc-site outputs.
site/
.venv-docs/

# Claude Code scratch: agent transcripts, per-agent worktrees, memory.
.claude/

# Local photos / captures from the hardware-operator agents.
photos/

# On-device diagnostic dumps (heap traces, coredumps, addr2line output).
# Build-environment-specific and not useful in version control.
docs/diag/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
/tools/nvs_gen/out/

# Cloudflare Wrangler local state
.wrangler/

# MCP server config that pins per-project servers / tokens locally.
.mcp.json

# components/fonts/CMakeLists.txt gzips each TTF at configure time and
# writes the result here, then EMBED_FILES the .gz. Regenerated on every
# clean configure; the .ttf source is the only thing under version
# control.
components/fonts/.gz_cache/
